rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && currentUser().data.isActive != false
        && currentUser().data.is_active != false;
    }

    function profileRole() {
      return currentUser().data.role;
    }

    function hasRole(role) {
      return activeUser() && profileRole() == role;
    }

    function hasAnyRole(roles) {
      return activeUser() && profileRole() in roles;
    }

    function isAdmin() {
      return hasAnyRole(['admin', 'Admin', 'ADMIN', ' admin', 'admin ', ' admin ']);
    }

    function isOperatorLapangan() {
      return hasAnyRole(['operator_lapangan', 'operator']);
    }

    function isOperatorKeuangan() {
      return hasRole('operator_keuangan');
    }

    function canManageOperations() {
      return isAdmin() || isOperatorLapangan();
    }

    function canManageFinance() {
      return isAdmin() || isOperatorKeuangan();
    }

    function supportedRole(role) {
      return role in [
        'admin',
        'Admin',
        'ADMIN',
        ' admin',
        'admin ',
        ' admin ',
        'operator_lapangan',
        'operator_keuangan',
        'operator',
        'mitra',
        'peserta_edukasi'
      ];
    }

    function createsOwnDocument(documentId) {
      return request.resource.data.id == documentId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.isDeleted == false;
    }

    function updatesExistingDocument() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function canReadNotification(data) {
      return activeUser() && (
        data.userId == request.auth.uid
        || data.targetRole in ['all', profileRole()]
        || isAdmin()
      );
    }

    match /users/{uid} {
      allow create: if (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.role == 'operator_lapangan'
        && request.resource.data.isActive == true
      ) || (
        isAdmin()
        && request.resource.data.uid == uid
        && request.resource.data.id == uid
        && supportedRole(request.resource.data.role)
      );

      allow read: if signedIn() && (
        request.auth.uid == uid || isAdmin()
      );

      allow update: if (
        isAdmin()
        && supportedRole(request.resource.data.role)
      ) || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id',
          'uid',
          'name',
          'email',
          'photoUrl',
          'role',
          'isActive',
          'fcmToken',
          'fcmTokenUpdatedAt',
          'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    match /farm_modules/{moduleId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /logbooks/{logbookId} {
      allow read: if activeUser();
      allow create: if canManageOperations() && createsOwnDocument(logbookId);
      allow update: if canManageOperations()
        && updatesExistingDocument()
        && (isAdmin() || request.resource.data.isDeleted == resource.data.isDeleted);
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if activeUser();
      allow create: if canManageOperations() && createsOwnDocument(itemId);
      allow update: if canManageOperations()
        && updatesExistingDocument()
        && (isAdmin() || request.resource.data.isDeleted == resource.data.isDeleted);
      allow delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if activeUser();
      allow create: if canManageOperations() && createsOwnDocument(scheduleId);
      allow update: if canManageOperations()
        && updatesExistingDocument()
        && (isAdmin() || request.resource.data.isDeleted == resource.data.isDeleted);
      allow delete: if isAdmin();
    }

    match /education_contents/{contentId} {
      allow read: if activeUser() && (
        resource.data.isPublished == true || isAdmin()
      );
      allow create: if isAdmin() && createsOwnDocument(contentId);
      allow update: if isAdmin() && updatesExistingDocument();
      allow delete: if isAdmin();
    }

    match /finance_transactions/{transactionId} {
      allow read: if activeUser();
      allow create: if canManageFinance() && createsOwnDocument(transactionId);
      allow update: if canManageFinance()
        && updatesExistingDocument()
        && (isAdmin() || request.resource.data.isDeleted == resource.data.isDeleted);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if canReadNotification(resource.data);
      allow create: if activeUser()
        && request.resource.data.id == notificationId
        && request.resource.data.isDeleted == false
        && canReadNotification(request.resource.data);
      allow update: if canReadNotification(resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead',
          'readAt'
        ]);
      allow delete: if isAdmin();
    }

    match /report_metadata/{reportId} {
      allow read: if activeUser();
      allow write: if isAdmin() || isOperatorKeuangan();
    }

    match /recommendations/{recommendationId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
