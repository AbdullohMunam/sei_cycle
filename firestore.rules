rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.is_active == true;
    }

    function profileRole() {
      return currentUser().data.role;
    }

    function hasRole(role) {
      return activeUser() && profileRole() == role;
    }

    function hasAnyRole(roles) {
      return activeUser() && profileRole() in roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOperatorLapangan() {
      return hasAnyRole(['operator_lapangan', 'operator']);
    }

    function isOperatorKeuangan() {
      return hasRole('operator_keuangan');
    }

    function canManageOperations() {
      return isAdmin() || isOperatorLapangan();
    }

    function canManageFinance() {
      return isAdmin() || isOperatorKeuangan();
    }

    function supportedRole(role) {
      return role in [
        'admin',
        'operator_lapangan',
        'operator_keuangan',
        'operator',
        'mitra',
        'peserta_edukasi'
      ];
    }


    match /users/{uid} {
      allow create: if (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'operator_lapangan'
        && request.resource.data.is_active == true
      ) || (
        isAdmin()
        && request.resource.data.uid == uid
        && supportedRole(request.resource.data.role)
      );

      allow read: if signedIn() && (
        request.auth.uid == uid || isAdmin()
      );

      allow update: if (
        isAdmin()
        && supportedRole(request.resource.data.role)
      ) || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.is_active == resource.data.is_active
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'name',
          'email',
          'photo_url',
          'role',
          'is_active',
          'updated_at'
        ])
      );

      allow delete: if isAdmin();
    }

    match /farm_modules/{moduleId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /logbooks/{logbookId} {
      allow read: if activeUser();
      allow create: if canManageOperations()
        && request.resource.data.id == logbookId
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.is_deleted == false;
      allow update: if canManageOperations()
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_by == resource.data.created_by;
      allow delete: if isAdmin();
    }

    match /inventory_items/{itemId} {
      allow read: if activeUser();
      allow create: if canManageOperations()
        && request.resource.data.id == itemId
        && request.resource.data.created_by == request.auth.uid;
      allow update: if canManageOperations()
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_by == resource.data.created_by;
      allow delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if activeUser();
      allow create: if canManageOperations()
        && request.resource.data.id == scheduleId
        && request.resource.data.created_by == request.auth.uid;
      allow update: if canManageOperations()
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_by == resource.data.created_by;
      allow delete: if isAdmin();
    }

    match /education_contents/{contentId} {
      allow read: if activeUser() && (
        resource.data.is_published == true || isAdmin()
      );
      allow write: if isAdmin();
    }

    match /finance_records/{recordId} {
      allow read, write: if canManageFinance();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
